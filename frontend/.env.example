# Frontend settings: NAMES ONLY. Never put a real value in this file.
#
# To run locally: copy this file to frontend/.env.local (git ignores it) and
# fill in values for your machine. On Vercel, the same names are set per
# environment. Full map: docs/SERVICES.md.
#
# WARNING: any name starting with NEXT_PUBLIC_ is built into the JavaScript that
# every visitor downloads. Only non-secret values may use that prefix.
# Secrets belong to the backend, never here.

# --- Environment ---
# local, staging or production
APP_ENV=
# Public address of the site. Locally: http://localhost:3000
APP_BASE_URL=

# --- Error tracking (Sentry, browser side; the DSN is not a secret) ---
NEXT_PUBLIC_SENTRY_DSN=

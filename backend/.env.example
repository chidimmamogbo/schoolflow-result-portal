# Backend settings: NAMES ONLY. Never put a real value in this file.
#
# To run locally: copy this file to backend/.env (git ignores .env) and fill in
# values for your machine. On Vercel, the same names are set per environment
# (Production and Preview get different values). Full map: docs/SERVICES.md.

# --- Environment ---
# local, staging or production
APP_ENV=
# Public address of the site, for links in emails. Locally: http://localhost:3000
APP_BASE_URL=

# --- Database (PostgreSQL) ---
# Each URL uses a different database role with different powers (D-026).
# Format: postgresql+psycopg://ROLE:PASSWORD@HOST:PORT/DATABASE
# Locally these point at Docker Postgres; on Vercel at the Neon branch.
# Day-to-day app queries (role app_user, pooled connection)
DATABASE_URL=
# Super admin platform routes only (role app_platform, cannot read pupil scores)
DATABASE_URL_PLATFORM=
# Public QR verification only (role app_verifier)
DATABASE_URL_VERIFIER=
# The background email sender only (role app_sender)
DATABASE_URL_SENDER=
# Migrations only (owner role, direct connection). Used by Alembic on your
# machine, in CI and in the deploy job; never set on Vercel.
DATABASE_URL_MIGRATIONS=
# The separate test database (pytest). Locally: the schoolflow_test database
# in Docker, see compose.yaml at the repo root.
TEST_DATABASE_URL=

# --- Security ---
# Long random value used to hash tokens and protect forms (CSRF).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- Email (Resend) ---
# Sending-only key for notify.meritiaa.com. Optional locally: tests use a fake sender.
RESEND_API_KEY=
# Domain emails are sent from (notify.meritiaa.com)
EMAIL_FROM_DOMAIN=

# --- Payments (Paystack, TEST mode only) ---
# Must be an sk_test_ key from the SchoolFlow business, never the meritiaa business.
PAYSTACK_SECRET_KEY=

# --- Error tracking (Sentry) ---
SENTRY_DSN=

# Not listed here on purpose:
# - Vercel Blob access: Vercel injects it automatically; locally files go to a folder.
# - Staging and production migration and deploy credentials: they live only in
#   GitHub Actions secrets (your .env holds only local Docker values).
